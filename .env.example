# Copier en .env
JWT_SECRET=remplacer-par-une-chaine-aleatoire-de-32-caracteres-minimum
CORS_ORIGINS=http://localhost:5173

# "fake" = réponses simulées, sans clé. "anthropic" = API Claude.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Ollama (LLM_PROVIDER=ollama)
# Ollama installé sur la machine hôte, back dans Docker : http://host.docker.internal:11434
# Back lancé en local : http://localhost:11434 — service "ollama" du compose : http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
